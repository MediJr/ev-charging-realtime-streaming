# Copier ce fichier en .env, puis remplacer les valeurs. Le fichier .env n'est jamais versionné.

# --- PostgreSQL : catalogue Iceberg (schéma iceberg) et base de diffusion pour Grafana (schéma serving) ---
POSTGRES_USER=lumio
POSTGRES_PASSWORD=remplacez-moi
POSTGRES_DB=lumio

# --- Stockage S3 du lakehouse (SeaweedFS) ---
S3_ACCESS_KEY=lumio_lake
S3_SECRET_KEY=remplacez-moi
LAKE_BUCKET=lumio-lake

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=remplacez-moi

# --- Simulateur (démonstration) ---
SIM_CHARGERS=200                # nombre de bornes simulées
SIM_INTERVAL_SECONDS=5          # une mesure par borne toutes les 5 s
SIM_SEED=42                     # même graine = même scénario
