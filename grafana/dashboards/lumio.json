            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Santé du flux : débit et retardataires écartés",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lumio-pg"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lumio-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT batch_time AS time, input_rows_per_second AS \"messages/s\", rows_dropped_by_watermark AS \"écartés (watermark)\"\nFROM serving.stream_progress WHERE query_name = 'silver' AND $__timeFilter(batch_time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Recharges en cours : énergie et CO₂ en direct",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lumio-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lumio-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT charger_id AS \"borne\", site_id AS \"site\", session_id AS \"session\", round(power_kw, 1) AS \"kW\",\n  round(energy_kwh, 2) AS \"kWh\", round(co2_g) AS \"g CO₂\", co2_g_per_kwh AS \"g/kWh RTE\"\nFROM serving.v_live_sessions ORDER BY energy_kwh DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
