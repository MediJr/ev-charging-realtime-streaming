        "uid": "lumio-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lumio-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT alert_type AS \"type\", count(*) AS \"alertes\" FROM serving.alerts\nWHERE $__timeFilter(anomaly_time) GROUP BY 1 ORDER BY 2 DESC"
        }
